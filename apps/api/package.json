{
  "name": "@peregrinos/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:init": "prisma migrate dev --create-only --name init && cat prisma/sql/checkin_active_unique.sql >> prisma/migrations/*_init/migration.sql && prisma migrate dev && tsx prisma/seed.ts",
    "geo:dry-run": "tsx geo/importers/cli/dry-run.ts",
    "geo:test": "node --import tsx --test \"geo/importers/tests/*.test.ts\"",
    "geo:typecheck": "tsc -p geo/tsconfig.json",
    "test:a1": "node --import tsx --test \"test/*.test.ts\"",
    "platform:create-admin": "tsx scripts/create-platform-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@peregrinos/shared": "*",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/qrcode": "^1.5.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9"
  }
}
