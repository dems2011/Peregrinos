generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Preparado para múltiples organizaciones.
model Organization {
  id   String @id @default(uuid())
  name String

  // Perfil público de la parroquia
  description String?
  address     String?
  phone       String?
  email       String?
  logoUrl     String?

  // Redes sociales
  instagram   String?
  facebook    String?
  youtube     String?
  tiktok      String?
  otherSocial String?
  website     String?

  // Estado público
  isActive Boolean @default(true)

  /// A3: ciclo de vida (fuente de verdad; isActive NO lo sustituye). Las organizaciones previas a A3 quedan APPROVED.
  status OrganizationStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  events        Event[]
  invitations   Invitation[]
  users         User[]
  request       OrganizationRequest?
  statusChanges OrganizationStatusChange[]
  /// A4a: personas registradas por esta organización que aún no reclamó su titular.
  persons       Person[]
  /// A5.0: registros de esta organización unidos a cuentas globales (reversibles por esta organización).
  personClaims  PersonClaim[]
}

/// A4a: identidad humana. Independiente de la cuenta (User), de la participación (Participant) y de la inscripción
/// (Registration). Puede existir sin cuenta; como máximo UNA cuenta (User.personId es único: lo garantiza la BD).
/// ownerOrganizationId != null → registro de esa organización (editable por su personal mientras nadie la reclame).
/// ownerOrganizationId == null → controlada por su titular (vinculada a una cuenta con prueba de posesión).
/// Nunca se borra: una duplicada se marca con mergedIntoId al fusionarla de forma explícita.
model Person {
  id                      String                   @id @default(uuid())
  firstName               String
  /// Opcional: culturas con un solo nombre y cuentas heredadas cuyo nombre completo no se parte (backfill A4a).
  lastName                String?
  documentType            String?
  /// Normalizado (solo dígitos/letras). No es único: la coincidencia nunca fusiona automáticamente.
  documentNumber          String?
  phone                   String?
  phoneDigits             String                   @default("")
  email                   String?
  /// Preparado para determinar mayoría/minoría según país (A4); todavía sin consentimiento parental.
  birthDate               DateTime?                @db.Date
  ownerOrganizationId     String?
  mergedIntoId            String?
  /// Código de vinculación de un solo uso que emite el personal y canjea el titular desde su cuenta (solo el hash).
  claimCodeHash           String?                  @unique
  claimCodeExpiresAt      DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  ownerOrganization       Organization?            @relation(fields: [ownerOrganizationId], references: [id], onDelete: Restrict)
  mergedInto              Person?                  @relation("PersonMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom              Person[]                 @relation("PersonMerge")
  user                    User?
  participants            Participant[]
  registrations           Registration[]
  /// A5.0: uniones donde esta Person es la identidad global (cuenta) o el registro de organización unido.
  claimsAsGlobal          PersonClaim[]            @relation("PersonClaimGlobal")
  claimsAsSource          PersonClaim[]            @relation("PersonClaimSource")
  /// A5.1: participaciones como voluntario (la misma Person, sin duplicar identidad).
  volunteerParticipations VolunteerParticipation[]

  @@index([ownerOrganizationId, lastName, firstName])
  @@index([documentNumber])
  @@index([phoneDigits])
  @@index([mergedIntoId])
}

/// A5.0: unión explícita de un registro de organización (sourcePerson, de ownerOrganizationId) a la identidad global
/// de una cuenta (person = User.personId). La crea el titular con el código que emitió la organización y su confirmación.
/// Guarda exactamente qué se movió para que SOLO esa organización pueda revertirlo (desvincular), sin tocar nada más.
model PersonClaim {
  id                   String       @id @default(uuid())
  personId             String
  sourcePersonId       String
  organizationId       String
  userId               String
  movedParticipantIds  String[]     @default([])
  movedRegistrationIds String[]     @default([])
  /// A5.1: participaciones como voluntario movidas por la unión.
  movedVolunteerIds    String[]     @default([])
  claimedAt            DateTime     @default(now())
  reversedAt           DateTime?
  reversedById         String?
  person               Person       @relation("PersonClaimGlobal", fields: [personId], references: [id], onDelete: Restrict)
  sourcePerson         Person       @relation("PersonClaimSource", fields: [sourcePersonId], references: [id], onDelete: Restrict)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([personId, organizationId])
  @@index([sourcePersonId])
}

/// A2: identidad separada de la autorización del personal.
/// STAFF: organizationId y role obligatorios. PILGRIM: sin organizationId, sin role y sin extraPermissions.
/// Ambas reglas las impone la BD con CHECK (migración 20261006000000_pilgrim_identity_separation).
/// La relación del peregrino con parroquias y eventos se deriva de Participant/Registration → Event → Organization.
model User {
  id                       String                     @id @default(uuid())
  organizationId           String?
  email                    String                     @unique
  name                     String
  passwordHash             String
  role                     Role?
  isActive                 Boolean                    @default(true)
  /// Permisos activados individualmente (además de los del rol).
  extraPermissions         String[]                   @default([])
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  documentNumber           String?                    @unique
  emailVerifiedAt          DateTime?
  phone                    String?
  photoUrl                 String?
  accountType              AccountType                @default(STAFF)
  termsAcceptedAt          DateTime?
  /// A4a: persona titular de la cuenta. Único → una Person tiene como máximo una cuenta. PILGRIM la exige (CHECK).
  /// STAFF puede tenerla; PLATFORM puede no tenerla. documentNumber/phone de User quedan como dato heredado:
  /// la identidad vive en Person (documentNumber se conserva solo como clave de unicidad de cuenta de A2).
  personId                 String?                    @unique
  person                   Person?                    @relation(fields: [personId], references: [id], onDelete: Restrict)
  auditLogs                AuditLog[]
  checkins                 Checkin[]                  @relation("CheckinOperator")
  emailVerificationTokens  EmailVerificationToken[]
  /// A5.0: tokens de recuperación de contraseña (solo hash).
  passwordResetTokens      PasswordResetToken[]
  /// A5.1: códigos de consentimiento de voluntariado (propios) y solicitudes enviadas como personal.
  volunteerConsentCodes    VolunteerConsentCode[]     @relation("VolunteerConsentOwner")
  volunteerConsentRequests VolunteerConsentCode[]     @relation("VolunteerConsentRequester")
  /// A5.0: uniones de registros de organizaciones a la Person de esta cuenta.
  personClaims             PersonClaim[]
  /// A5.0: versión de las sesiones de la cuenta del peregrino (va en el JWT). Cambiar o restablecer la contraseña la
  /// incrementa e invalida las sesiones emitidas antes.
  sessionVersion           Int                        @default(0)
  /// A6: MFA (TOTP). Secreto cifrado con AES-256-GCM (lib/mfa.ts); nunca en claro. mfaEnabledAt != null ⇔ MFA activo.
  mfaTotpSecret            String?
  /// A6: secreto del enrolamiento en curso (cifrado); pasa a mfaTotpSecret al confirmar con un código válido.
  mfaPendingSecret         String?
  mfaPendingAt             DateTime?
  mfaEnabledAt             DateTime?
  /// A6: último paso TOTP aceptado (anti-replay: un código sirve una sola vez).
  mfaLastStep              Int?
  /// A6: intentos fallidos consecutivos de segundo factor y bloqueo temporal por cuenta.
  mfaFailedCount           Int                        @default(0)
  mfaLockedUntil           DateTime?
  mfaRecoveryCodes         MfaRecoveryCode[]
  incidents                Incident[]
  invitationsSent          Invitation[]               @relation("InvitationInviter")
  /// A3: solicitudes de parroquia revisadas (solo PLATFORM) y transiciones registradas por esta cuenta.
  requestsReviewed         OrganizationRequest[]      @relation("OrganizationRequestReviewer")
  statusChanges            OrganizationStatusChange[]
  assignments              OperatorAssignment[]
  refreshTokens            RefreshToken[]
  /// Solo cuentas PILGRIM: sus participaciones e inscripciones por evento (se valida en código).
  participations           Participant[]              @relation("PilgrimParticipations")
  registrations            Registration[]             @relation("PilgrimRegistrations")
  organization             Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?
  /// A6: momento del último segundo factor verificado en esta sesión; viaja al access token (step-up).
  mfaAt     DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A6: códigos de recuperación MFA de un solo uso. Solo el HMAC del código (clave derivada del servidor).
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id                       String                   @id @default(uuid())
  organizationId           String
  name                     String
  description              String?
  startsAt                 DateTime
  timezone                 String                   @default("America/Argentina/Buenos_Aires")
  status                   EventStatus              @default(DRAFT)
  /// Nombre de la parroquia que aparece en la credencial (si falta, se usa el de la organización).
  parishName               String?
  /// Inscripción abierta: el peregrino se registra con un enlace público y envía su comprobante.
  registrationOpen         Boolean                  @default(false)
  registrationToken        String?                  @unique
  registrationFee          Decimal?                 @db.Decimal(12, 2)
  paymentInstructions      String?
  /// Tipo de evento. La peregrinación es un tipo más; lo que habilita cada tipo se define en packages/shared (EVENT_TYPE_INFO).
  type                     EventType                @default(OTHER)
  endsAt                   DateTime?
  /// Lugar general del evento (templo, plaza, salón). El trayecto, si lo hay, vive en EventRoute.
  locationName             String?
  address                  String?
  latitude                 Float?
  longitude                Float?
  /// Cupo informativo del evento (todavía no limita inscripciones).
  capacity                 Int?
  visibility               EventVisibility          @default(PRIVATE)
  /// Ventana opcional de inscripción. registrationOpen sigue siendo el interruptor principal.
  registrationOpensAt      DateTime?
  registrationClosesAt     DateTime?
  certificateEnabled       Boolean                  @default(false)
  certificatePhrase        String?
  /// Opciones menores propias del tipo, validadas con Zod (eventSettingsSchemas en packages/shared).
  settings                 Json                     @default("{}")
  /// A4: módulos que usa el evento. El tipo solo propone valores iniciales; las dependencias, reservadas y
  /// coherencia con los datos del evento las impone la BD con CHECK (migración 20261008000000_event_capabilities).
  capabilities             EventCapability[]        @default([INFO, LOCATION, REGISTRATION, PARTICIPANTS, CHECKIN, ROUTE, POINTS, CONTACTS, CERTIFICATES])
  route                    EventRoute?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  checkins                 Checkin[]
  checkpoints              Checkpoint[]
  organization             Organization             @relation(fields: [organizationId], references: [id])
  contacts                 EventContact[]
  incidents                Incident[]
  assignments              OperatorAssignment[]
  participants             Participant[]
  groups                   ParticipantGroup[]
  registrations            Registration[]
  syncQueue                SyncQueue[]
  /// A5.1: voluntariado del evento (capacidad VOLUNTEERS).
  volunteers               VolunteerParticipation[]
  teams                    Team[]
  zones                    Zone[]
  dutyFunctions            DutyFunction[]
  shifts                   Shift[]
  volunteerAssignments     VolunteerAssignment[]
  /// A5.1: solicitudes de consentimiento de voluntariado para este evento.
  volunteerConsentRequests VolunteerConsentCode[]

  @@index([organizationId, status])
  @@index([organizationId, type])
}

/// Trayecto de un evento (origen → destino). Estructura genérica para cualquier tipo con recorrido;
/// qué tipos pueden tenerla lo decide EVENT_TYPE_INFO[type].hasRoute, no la base de datos.
model EventRoute {
  eventId            String   @id
  originName         String?
  originAddress      String?
  originLat          Float?
  originLng          Float?
  destinationName    String?
  destinationAddress String?
  destinationLat     Float?
  destinationLng     Float?
  distanceKm         Decimal? @db.Decimal(7, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum EventType {
  PILGRIMAGE
  PROCESSION
  PATRONAL_FEAST
  LITURGICAL_CELEBRATION
  ROSARY
  RETREAT
  GATHERING
  COMMUNITY_ACTIVITY
  CULTURAL_ACTIVITY
  OTHER
}

/// A4: capacidades de un evento. VOLUNTEERS, COMMUNICATIONS y DOCUMENTS están reservadas (A5/A6): un CHECK las rechaza.
enum EventCapability {
  INFO
  LOCATION
  REGISTRATION
  PARTICIPANTS
  CHECKIN
  ROUTE
  POINTS
  CONTACTS
  CERTIFICATES
  VOLUNTEERS
  COMMUNICATIONS
  DOCUMENTS
}

/// PRIVATE: solo personal · UNLISTED: accesible con enlace · PUBLIC: listable públicamente (directorio futuro).
enum EventVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

/// Preparado para grupos/familias.
model ParticipantGroup {
  id           String        @id @default(uuid())
  eventId      String
  name         String
  participants Participant[]
  event        Event         @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

model Participant {
  id                    String            @id @default(uuid())
  eventId               String
  /// Número visible (1 -> "001"). Único por evento.
  number                Int
  firstName             String
  lastName              String
  /// Documento normalizado (solo dígitos/letras, sin puntos). Único por evento.
  documentNumber        String
  documentType          String            @default("DNI")
  phone                 String
  /// Solo dígitos del teléfono, para buscar sin importar el formato.
  phoneDigits           String            @default("")
  /// Token opaco del QR. No contiene datos personales.
  qrToken               String            @unique
  /// Acceso del peregrino: solo se guardan hashes (enlace y código corto).
  accessTokenHash       String?           @unique
  accessCodeHash        String?           @unique
  accessIssuedAt        DateTime?
  /// La credencial queda disponible desde que la persona entra al listado oficial.
  credentialIssuedAt    DateTime          @default(now())
  credentialPrintedAt   DateTime?
  photoUrl              String?
  notes                 String?
  status                ParticipantStatus @default(ACTIVE)
  groupId               String?
  /// Preparado para menores y contacto de emergencia.
  isMinor               Boolean           @default(false)
  emergencyContactName  String?
  emergencyContactPhone String?
  /// Heredado (A2, nunca se escribió). La participación pertenece a la Person (personId), no a la cuenta.
  /// El acceso operativo por enlace/código (PilgrimSession) es independiente de esta cuenta.
  userId                String?
  /// A4a: quién participa. Obligatorio; la Person puede no tener cuenta. Nombre/documento de Participant
  /// quedan como instantánea de lo inscrito (credencial e histórico).
  personId              String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  checkins              Checkin[]
  incidents             Incident[]
  event                 Event             @relation(fields: [eventId], references: [id])
  group                 ParticipantGroup? @relation(fields: [groupId], references: [id])
  user                  User?             @relation("PilgrimParticipations", fields: [userId], references: [id], onDelete: SetNull)
  person                Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  pilgrimSessions       PilgrimSession[]
  registration          Registration?

  @@unique([eventId, number])
  @@unique([eventId, documentNumber])
  @@unique([id, eventId])
  /// Una cuenta participa como máximo una vez por evento.
  @@unique([eventId, userId])
  /// A4a: una persona participa como máximo una vez por evento.
  @@unique([eventId, personId])
  @@index([personId])
  @@index([eventId, lastName, firstName])
  @@index([eventId, phoneDigits])
  @@index([userId])
}

model Checkpoint {
  id          String               @id @default(uuid())
  eventId     String
  order       Int
  name        String
  description String?
  address     String?
  reference   String?
  latitude    Float?
  longitude   Float?
  capacity    Int?
  status      CheckpointStatus     @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  checkins    Checkin[]
  event       Event                @relation(fields: [eventId], references: [id])
  contacts    EventContact[]
  incidents   Incident[]
  assignments OperatorAssignment[]

  @@unique([eventId, order])
  @@unique([id, eventId])
}

/// Un operador puede tener uno o varios puntos asignados.
model OperatorAssignment {
  id           String     @id @default(uuid())
  userId       String
  eventId      String
  checkpointId String
  createdAt    DateTime   @default(now())
  checkpoint   Checkpoint @relation(fields: [checkpointId, eventId], references: [id, eventId])
  event        Event      @relation(fields: [eventId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkpointId])
  @@index([userId])
}

model Checkin {
  /// UUID generado por el cliente (idempotencia en la sincronización).
  id            String        @id @default(uuid())
  eventId       String
  participantId String
  checkpointId  String
  operatorId    String
  /// Momento real de la llegada (reloj del dispositivo).
  timestamp     DateTime
  method        CheckinMethod
  latitude      Float?
  longitude     Float?
  deviceId      String?
  status        CheckinStatus @default(ACTIVE)
  syncStatus    SyncStatus    @default(SYNCED)
  /// Si es CONFLICT: id del registro ACTIVE con el que choca.
  conflictOfId  String?
  cancelReason  String?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  checkpoint    Checkpoint    @relation(fields: [checkpointId, eventId], references: [id, eventId])
  event         Event         @relation(fields: [eventId], references: [id])
  operator      User          @relation("CheckinOperator", fields: [operatorId], references: [id])
  participant   Participant   @relation(fields: [participantId, eventId], references: [id, eventId])

  @@index([eventId, checkpointId, timestamp])
  @@index([eventId, participantId])
}

model Incident {
  id            String         @id @default(uuid())
  eventId       String
  participantId String?
  checkpointId  String?
  operatorId    String
  type          IncidentType
  description   String
  status        IncidentStatus @default(OPEN)
  occurredAt    DateTime       @default(now())
  createdAt     DateTime       @default(now())
  checkpoint    Checkpoint?    @relation(fields: [checkpointId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id])
  operator      User           @relation(fields: [operatorId], references: [id])
  participant   Participant?   @relation(fields: [participantId], references: [id])

  @@index([eventId, status])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  eventId        String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])

  @@index([eventId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

/// Cola de sincronización del lado servidor (lotes recibidos desde dispositivos offline).
model SyncQueue {
  id          String     @id @default(uuid())
  /// ID generado por el cliente para esta operación (idempotencia).
  clientId    String     @unique
  eventId     String
  operatorId  String
  deviceId    String?
  type        String
  payload     Json
  status      SyncStatus @default(PENDING)
  attempts    Int        @default(0)
  lastError   String?
  createdAt   DateTime   @default(now())
  processedAt DateTime?
  event       Event      @relation(fields: [eventId], references: [id])

  @@index([eventId, status])
}

/// Invitación por correo para sumar personal con un nivel de acceso definido.
model Invitation {
  id               String       @id @default(uuid())
  organizationId   String
  email            String
  role             Role
  extraPermissions String[]     @default([])
  /// Puntos de control que se asignarán al aceptar (solo operadores).
  checkpointIds    String[]     @default([])
  tokenHash        String       @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  revokedAt        DateTime?
  acceptedUserId   String?
  invitedById      String
  lastSentAt       DateTime?
  sendCount        Int          @default(0)
  /// A3: invitación de fundador emitida por PLATFORM al aprobar una solicitud. Único caso en que una invitación
  /// puede otorgar SUPERADMIN (la BD exige role=SUPERADMIN si es true).
  platformGrant    Boolean      @default(false)
  createdAt        DateTime     @default(now())
  invitedBy        User         @relation("InvitationInviter", fields: [invitedById], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, email])
}

/// Sesión del peregrino (separada del personal; solo ve sus propios datos).
model PilgrimSession {
  id             String        @id @default(uuid())
  /// Una sesión pertenece a una inscripción (aún sin verificar) o a un participante oficial.
  participantId  String?
  registrationId String?
  tokenHash      String        @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  userAgent      String?
  ip             String?
  participant    Participant?  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([registrationId])
}

/// Personas de la organización a quienes el peregrino puede recurrir.
model EventContact {
  id           String      @id @default(uuid())
  eventId      String
  checkpointId String?
  name         String
  roleLabel    String?
  phone        String
  email        String?
  notes        String?
  isEmergency  Boolean     @default(false)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  checkpoint   Checkpoint? @relation(fields: [checkpointId], references: [id])
  event        Event       @relation(fields: [eventId], references: [id])

  @@index([eventId, sortOrder])
}

/// Inscripción de un peregrino que aún no está en el listado oficial.
/// Al aprobarla se crea el Participant (con su número y QR); hasta entonces no tiene número.
model Registration {
  id              String             @id @default(uuid())
  eventId         String
  firstName       String
  lastName        String
  documentNumber  String
  documentType    String             @default("DNI")
  phone           String
  phoneDigits     String             @default("")
  status          RegistrationStatus @default(PENDING_PROOF)
  accessTokenHash String?            @unique
  accessCodeHash  String?            @unique
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  participantId   String?            @unique
  /// Heredado (A2, nunca se escribió). La inscripción pertenece a la Person (personId), no a la cuenta.
  userId          String?
  /// A4a: quién se inscribe. Obligatorio; la Person puede no tener cuenta. Al aprobar, el Participant hereda la misma Person.
  personId        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  proofs          PaymentProof[]
  pilgrimSessions PilgrimSession[]
  event           Event              @relation(fields: [eventId], references: [id])
  participant     Participant?       @relation(fields: [participantId], references: [id])
  user            User?              @relation("PilgrimRegistrations", fields: [userId], references: [id], onDelete: SetNull)
  person          Person             @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([eventId, documentNumber])
  /// Una cuenta se inscribe como máximo una vez por evento.
  @@unique([eventId, userId])
  /// A4a: una persona se inscribe como máximo una vez por evento.
  @@unique([eventId, personId])
  @@index([eventId, status])
  @@index([userId])
  @@index([personId])
}

/// Comprobante de pago. El archivo vive fuera de la base (ver lib/storage.ts); aquí solo su referencia y huella.
model PaymentProof {
  id             String       @id @default(uuid())
  registrationId String
  storageKey     String       @unique
  mimeType       String
  sizeBytes      Int
  /// Huella SHA-256: detecta el mismo comprobante usado en dos inscripciones.
  sha256         String
  amount         Decimal?     @db.Decimal(12, 2)
  reference      String?
  paidAt         DateTime?
  note           String?
  status         ProofStatus  @default(SUBMITTED)
  createdAt      DateTime     @default(now())
  reviewedAt     DateTime?
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([sha256])
  @@index([registrationId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A5.0: recuperación de contraseña de cuentas PILGRIM. Token aleatorio de un solo uso; en la BD solo su hash.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum AccountType {
  STAFF
  PILGRIM
  /// A3: operador de plataforma (PLATFORM_ADMIN). Sin organización, sin rol y sin permisos extra (CHECK en BD).
  PLATFORM
}

/// A3: ciclo de vida de una organización (parroquia).
enum OrganizationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

/// A3: solicitud pública de una nueva parroquia. La Organization se crea solo al aprobarla (PLATFORM).
/// status ∈ {PENDING_REVIEW, APPROVED, REJECTED} (CHECK en BD).
model OrganizationRequest {
  id              String                     @id @default(uuid())
  parishName      String
  contactName     String
  contactEmail    String
  contactPhone    String?
  /// ISO 3166-1 alfa-2 (catálogo internacional G1).
  countryCode     String
  locality        String?
  address         String?
  notes           String?
  status          OrganizationStatus         @default(PENDING_REVIEW)
  /// Hash del token privado que permite al solicitante consultar y corregir su solicitud.
  editTokenHash   String                     @unique
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  submissionCount Int                        @default(1)
  organizationId  String?                    @unique
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  reviewedBy      User?                      @relation("OrganizationRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  organization    Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  statusChanges   OrganizationStatusChange[]

  @@index([status, createdAt])
  @@index([contactEmail])
}

/// A3: auditoría persistente (append-only) de cada transición de solicitud u organización.
model OrganizationStatusChange {
  id               String               @id @default(uuid())
  organizationId   String?
  requestId        String?
  fromStatus       OrganizationStatus?
  toStatus         OrganizationStatus
  /// Cuenta que ejecutó la transición (null: el solicitante público, sin cuenta).
  actorUserId      String?
  actorAccountType AccountType?
  reason           String?
  createdAt        DateTime             @default(now())
  organization     Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request          OrganizationRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor            User?                @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([requestId, createdAt])
}

enum Role {
  SUPERADMIN
  ADMIN
  OPERATOR
}

/// DRAFT: en preparación, no operativo · SCHEDULED: programado/publicado · IN_PROGRESS: activo · FINISHED: cerrado · CANCELLED: cancelado.
enum EventStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

/// A4: participación oficial ACTIVE (confirmada) o CANCELLED. ATTENDED/NO_SHOW se derivan de Checkin (sin columna).
enum ParticipantStatus {
  ACTIVE
  CANCELLED
}

enum CheckpointStatus {
  ACTIVE
  INACTIVE
}

enum CheckinMethod {
  NUMBER
  QR
  SEARCH
}

/// ACTIVE: válido. CANCELLED: anulado por corrección (nunca se borra). CONFLICT: duplicado detectado en sincronización.
enum CheckinStatus {
  ACTIVE
  CANCELLED
  CONFLICT
}

enum SyncStatus {
  SYNCED
  PENDING
  ERROR
}

enum IncidentType {
  INJURED
  LOST
  WRONG_DOCUMENT
  DUPLICATE
  ABANDONED
  EMERGENCY
  NOTE
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum RegistrationStatus {
  PENDING_PROOF
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ProofStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

/**
 * =====================  G1: CATÁLOGO GEOGRÁFICO INTERNACIONAL  =====================
 */
/**
 * Ver docs/ARQUITECTURA-INTERNACIONAL.md. La integridad se garantiza con FK compuestas y CHECK
 * (escritos a mano en la migración 20261005190000_geo_catalog; Prisma no los representa).
 */

/// División administrativa o localidad. Estructural y cerrado: no limita la cantidad de niveles.
enum AreaKind {
  ADMIN
  LOCALITY
}

/// Estado de verificación de un dato de catálogo contra su fuente primaria. Un dato dudoso nunca es VERIFIED.
enum GeoReviewStatus {
  PENDING
  VERIFIED
}

enum GeoImportStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// País o territorio con código ISO 3166-1 propio. Agregar uno = insertar una fila (nunca cambiar el esquema).
model Country {
  /// ISO 3166-1 alfa-2.
  code         String               @id @db.Char(2)
  /// ISO 3166-1 alfa-3.
  iso3         String?              @unique @db.Char(3)
  /// Nombres por idioma (Unicode CLDR): {"es":"…","en":"…","pt":"…","it":"…"}.
  names        Json
  /// Idiomas de uso en el país (BCP-47, CLDR). Sugerencia; la preferencia del usuario es independiente.
  locales      String[]             @default([])
  /// Moneda principal (ISO 4217).
  currencyCode String?              @db.Char(3)
  /// Código de país ITU-T E.164 ("+54"). No es único: +1 lo comparten varios países.
  phonePrefix  String?
  /// Zonas horarias del país (IANA tzdb).
  timezones    String[]             @default([])
  isEnabled    Boolean              @default(true)
  reviewStatus GeoReviewStatus      @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  levels       CountryAreaLevel[]
  areas        AdministrativeArea[]
  addresses    Address[]
}

/// Niveles de un país en orden (rank 1 = superior). Cantidad y nombres varían por país.
model CountryAreaLevel {
  id           String               @id @default(uuid())
  countryCode  String               @db.Char(2)
  rank         Int
  kind         AreaKind
  /// Etiqueta del nivel por idioma: {"es":"Provincia","en":"Province",…}.
  labels       Json
  /// Obligatorio en la selección de dirección.
  isRequired   Boolean              @default(false)
  reviewStatus GeoReviewStatus      @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  country      Country              @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  areas        AdministrativeArea[]

  @@unique([countryCode, rank])
  /// Destino de la FK compuesta de AdministrativeArea (el nivel y el tipo deben existir en la configuración del país).
  @@unique([countryCode, rank, kind])
}

/// División administrativa o localidad. parentId es la ÚNICA fuente de verdad de la jerarquía;
/// parentCountryCode/parentRank/parentKind son espejos del padre que la FK compuesta obliga a ser exactos.
model AdministrativeArea {
  /// Identificador interno estable: nunca se reutiliza ni se borra.
  id                String               @id @default(uuid())
  countryCode       String               @db.Char(2)
  rank              Int
  kind              AreaKind
  parentId          String?
  parentCountryCode String?              @db.Char(2)
  parentRank        Int?
  parentKind        AreaKind?
  /// SOLO códigos ISO 3166-2 (p. ej. "AR-B"). Los códigos de fuentes nacionales van en source/sourceId.
  isoCode           String?              @unique
  /// Fuente del registro ("GEOREF", "IBGE", "COD-AB", "MANUAL"…): texto para admitir fuentes nuevas sin migrar.
  source            String
  /// Identificador del registro en su fuente.
  sourceId          String
  name              String
  /// Minúsculas y sin tildes (misma función de normalización que usa la búsqueda).
  nameNormalized    String
  latitude          Float?
  longitude         Float?
  /// Si la fuente lo retira se desactiva; nunca se borra.
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  country           Country              @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  level             CountryAreaLevel     @relation(fields: [countryCode, rank, kind], references: [countryCode, rank, kind], onDelete: Restrict, onUpdate: Restrict)
  parent            AdministrativeArea?  @relation("AreaTree", fields: [parentId, parentCountryCode, parentRank, parentKind], references: [id, countryCode, rank, kind], onDelete: Restrict, onUpdate: Restrict)
  children          AdministrativeArea[] @relation("AreaTree")
  addresses         Address[]

  /// Destino de la FK compuesta de Address.
  @@unique([id, countryCode])
  /// Destino de la FK compuesta de los hijos.
  @@unique([id, countryCode, rank, kind])
  /// Identidad de importación.
  @@unique([countryCode, source, sourceId])
  @@index([parentId])
  @@index([countryCode, kind, rank])
  @@index([countryCode, nameNormalized])
}

/// Dirección reutilizable (parroquia, residencia, lugar de evento). En G1 todavía no tiene dueños.
/// Tres partes separadas: administrativa (país + área), textual y coordenadas.
model Address {
  id              String              @id @default(uuid())
  countryCode     String              @db.Char(2)
  /// Área más profunda elegida (ADMIN o LOCALITY).
  areaId          String?
  /// Espejo del país del área (FK compuesta + CHECK: igual a countryCode).
  areaCountryCode String?             @db.Char(2)
  /// Localidad que no está en el catálogo.
  localityText    String?
  line1           String?
  line2           String?
  postalCode      String?
  /// Coordenadas propias de la dirección (no derivan del área).
  latitude        Float?
  longitude       Float?
  /// Origen de las coordenadas ("USER_PIN" | "DEVICE_GPS" | "AREA_CENTROID"); lo valida la API/importador.
  geoSource       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  country         Country             @relation(fields: [countryCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  area            AdministrativeArea? @relation(fields: [areaId, areaCountryCode], references: [id, countryCode], onDelete: Restrict, onUpdate: Restrict)

  @@index([countryCode])
  @@index([areaId])
}

/// Auditoría de cada importación del catálogo: qué dataset, qué versión y qué resultado.
/// Sin FK a Country a propósito: el registro debe sobrevivir y puede crearse antes que el país.
model GeoImportRun {
  id               String          @id @default(uuid())
  /// "COUNTRIES" | "AREA_LEVELS" | "AREAS" (lo valida el importador).
  dataset          String
  /// null = catálogo mundial.
  countryCode      String?         @db.Char(2)
  source           String
  sourceVersion    String
  /// Huella del archivo importado. null solo si combina varios archivos (sus huellas van en details).
  sha256           String?         @db.Char(64)
  dryRun           Boolean         @default(false)
  status           GeoImportStatus @default(RUNNING)
  startedAt        DateTime        @default(now())
  finishedAt       DateTime?
  insertedCount    Int             @default(0)
  updatedCount     Int             @default(0)
  unchangedCount   Int             @default(0)
  deactivatedCount Int             @default(0)
  errorCount       Int             @default(0)
  /// Archivos y huellas, homónimos, errores y datos dudosos no cargados.
  details          Json?
  triggeredBy      String?

  @@index([countryCode, dataset, startedAt])
  @@index([source, sourceVersion])
}

/// A5.1 — Participación de una Person como voluntaria en un evento. No es un rol de cuenta (User.role sigue siendo
/// autorización del personal). Una por persona y evento. ASSIGNED/ACTIVE se derivan de las asignaciones vigentes.
enum VolunteerStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  REVOKED
  COMPLETED
}

/// A5.1 — Consentimiento de voluntariado entre organizaciones (sin directorio global de Personas).
/// 1) La cuenta genera un código (solo el hash; vence; un solo uso).
/// 2) Una organización lo canjea para UN evento: queda una solicitud pendiente, sin datos de la persona.
/// 3) La persona ve qué organización y qué evento la piden y acepta (se crea la VolunteerParticipation) o rechaza.
/// Distinto del código de vinculación (Person.claimCodeHash), que emite una organización para unir sus datos a una cuenta.
model VolunteerConsentCode {
  id            String                  @id @default(uuid())
  userId        String
  codeHash      String                  @unique
  /// Vigencia del paso actual: del código mientras no se canjea; de la solicitud una vez canjeado.
  expiresAt     DateTime
  createdAt     DateTime                @default(now())
  /// Canje por la organización (código consumido) para un evento concreto.
  usedAt        DateTime?
  eventId       String?
  requestedById String?
  /// Respuesta de la persona.
  acceptedAt    DateTime?
  declinedAt    DateTime?
  volunteerId   String?                 @unique
  user          User                    @relation("VolunteerConsentOwner", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy   User?                   @relation("VolunteerConsentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  event         Event?                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  volunteer     VolunteerParticipation? @relation(fields: [volunteerId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([eventId])
}

model VolunteerParticipation {
  id                String                @id @default(uuid())
  eventId           String
  personId          String
  status            VolunteerStatus       @default(REQUESTED)
  notes             String?
  /// Motivo del último rechazo o baja.
  decisionReason    String?
  createdById       String
  statusChangedById String?
  statusChangedAt   DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  event             Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  person            Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  assignments       VolunteerAssignment[]

  /// A5.1: código de consentimiento con el que se creó (si fue por código).
  consentCode VolunteerConsentCode?

  @@unique([eventId, personId])
  @@unique([id, eventId])
  @@index([personId])
  @@index([eventId, status])
}

/// A5.1 — Equipo operativo del evento. Nombre libre que define la organización; se desactiva, no se borra.
model Team {
  id          String                @id @default(uuid())
  eventId     String
  name        String
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  shifts      Shift[]
  assignments VolunteerAssignment[]

  @@unique([eventId, name])
  @@unique([id, eventId])
}

/// A5.1 — Zona operativa del evento (no necesariamente geográfica ni permanente).
model Zone {
  id          String                @id @default(uuid())
  eventId     String
  name        String
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  shifts      Shift[]
  assignments VolunteerAssignment[]

  @@unique([eventId, name])
  @@unique([id, eventId])
}

/// A5.1 — Función que realiza un voluntario (no se llama "Function": chocaría con el tipo global de JS).
model DutyFunction {
  id          String                @id @default(uuid())
  eventId     String
  name        String
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  assignments VolunteerAssignment[]

  @@unique([eventId, name])
  @@unique([id, eventId])
}

/// A5.1 — Turno. endsAt > startsAt (CHECK). Zona y equipo opcionales, del mismo evento (FK compuestas). Se cancela, no se borra.
model Shift {
  id          String                @id @default(uuid())
  eventId     String
  name        String?
  startsAt    DateTime
  endsAt      DateTime
  zoneId      String?
  teamId      String?
  cancelledAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  zone        Zone?                 @relation(fields: [zoneId, eventId], references: [id, eventId], onDelete: Restrict)
  team        Team?                 @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Restrict)
  assignments VolunteerAssignment[]

  @@unique([id, eventId])
  @@index([eventId, startsAt])
}

/// A5.1 — Asignación: quién (voluntario), haciendo qué (función), dónde (zona), cuándo (turno), con quién (equipo),
/// para qué evento. Todo del mismo evento (FK compuestas). Una asignación vigente no se duplica (índice parcial).
/// Se revoca (revokedAt), nunca se borra.
model VolunteerAssignment {
  id           String                 @id @default(uuid())
  eventId      String
  volunteerId  String
  functionId   String
  teamId       String?
  zoneId       String?
  shiftId      String?
  createdById  String
  createdAt    DateTime               @default(now())
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  volunteer    VolunteerParticipation @relation(fields: [volunteerId, eventId], references: [id, eventId], onDelete: Restrict)
  dutyFunction DutyFunction           @relation(fields: [functionId, eventId], references: [id, eventId], onDelete: Restrict)
  team         Team?                  @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Restrict)
  zone         Zone?                  @relation(fields: [zoneId, eventId], references: [id, eventId], onDelete: Restrict)
  shift        Shift?                 @relation(fields: [shiftId, eventId], references: [id, eventId], onDelete: Restrict)

  @@index([eventId])
  @@index([volunteerId])
  @@index([shiftId])
}
