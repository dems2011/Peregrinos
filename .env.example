# Copiar a apps/api/.env  (cp .env.example apps/api/.env)
DATABASE_URL="postgresql://peregrinos:peregrinos@localhost:5432/peregrinos?schema=public"
PORT=4000
NODE_ENV=development
# Origen del frontend (CORS con credenciales)
WEB_ORIGIN=http://localhost:3000
# Mínimo 32 caracteres. Generar: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14
# true en producción (HTTPS)
COOKIE_SECURE=false
# Contraseña de los usuarios demo del seed
SEED_PASSWORD=Peregrinos2026!

# --- Fase 3A ---
# Correo para invitaciones (opcional). Sin esto el enlace se imprime en la consola y se puede copiar desde el panel.
# SMTP_URL=smtp://usuario:clave@smtp.tu-proveedor.com:587
MAIL_FROM="Peregrinos <no-reply@tudominio.com>"
INVITE_TTL_DAYS=7
PILGRIM_SESSION_DAYS=60

# --- Comprobantes de pago ---
# Carpeta privada (nunca se sirve públicamente). En producción usa un volumen persistente y respáldalo.
UPLOAD_DIR=./uploads
